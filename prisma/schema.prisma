// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  unitCode  String   // e.g. "TUH"
  unitName  String   // e.g. "Đài DVOR/DME Tuy Hòa"
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections Inspection[]
}

model Category {
  id          String   @id // e.g. "quan-ly-ky-thuat"
  title       String
  shortTitle  String?
  subtitle    String?
  description String?
  iconName    String?
  color       String?
  hoverColor  String?
  gradient    String?
  bgImage     String?
  
  groups      ChecklistGroup[]
  inspections Inspection[]
}

model ChecklistGroup {
  id         String   @id @default(cuid())
  categoryId String
  order      String   // Can be "1", "1.1", etc.
  title      String
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items      ChecklistItem[]
}

model ChecklistItem {
  id            String   @id @default(cuid())
  groupId       String
  orderIndex    String   // e.g. "1.1.1", "a", "-"
  title         String
  statusOptions String?  // comma-separated, e.g. "Tốt,Bình thường,Cần cải thiện" or "Có,Không"
  reference     String?  // Reference docs template
  
  group         ChecklistGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  results       InspectionResult[]
}

model Inspection {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("DRAFT") // DRAFT, SUBMITTED
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  results     InspectionResult[]
}

model InspectionResult {
  id            String   @id @default(cuid())
  inspectionId  String
  checklistItemId String
  status        Json?
  reference     String?
  note          String?
  evidencePdf   Json?
  evidenceImg   Json?
  
  inspection    Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, checklistItemId])
}
